# Token del bot que te da @BotFather
TELEGRAM_BOT_TOKEN=

# IDs de Telegram (numericos, separados por coma) autorizados a usar el bot
# en chats PRIVADOS. En grupos donde esté el bot, cualquier miembro puede usarlo.
# Para saber tu ID puedes hablar con @userinfobot.
ALLOWED_USERS=

# Imagen Docker a usar (sin tag). En local puede ser cualquier cosa, ej. "telestas/telegram-bot".
# En el servidor lo sobreescribe la CI con <DOCKERHUB_USERNAME>/telegram-bot.
IMAGE=telestas/telegram-bot

# Tag de la imagen. En local "latest"; en el servidor lo sobreescribe la CI con el tag de git (vX.Y.Z).
IMAGE_TAG=latest

# Opcional
TZ=UTC
